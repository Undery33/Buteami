#!/bin/sh
# Sourced by the official nginx entrypoint before 20-envsubst-on-templates.sh.
# Discover the actual pod/container resolver; do not assume a cluster DNS IP.
NGINX_RESOLVER="$(awk '/^nameserver[[:space:]]/ { if (index($2, ":")) print "[" $2 "]"; else print $2; exit }' /etc/resolv.conf)"
if [ -z "$NGINX_RESOLVER" ]; then
  echo "No nameserver configured in /etc/resolv.conf" >&2
  exit 1
fi
export NGINX_RESOLVER

# Nginx's request-time resolver does not apply the system DNS search suffix.
# The manifests use the default namespace. Docker's local alias remains useful
# when the container does not have a Kubernetes service search domain.
api_search_domain="$(awk '/^search[[:space:]]/ { for (i = 2; i <= NF; i++) if ($i ~ /^default[.]svc[.]/) { print $i; exit } }' /etc/resolv.conf)"
BUTEAMI_API_UPSTREAM="buteami-api:3000"
if [ -n "$api_search_domain" ]; then
  BUTEAMI_API_UPSTREAM="buteami-api.${api_search_domain}:3000"
fi
export BUTEAMI_API_UPSTREAM
