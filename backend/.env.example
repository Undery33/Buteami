# Development configuration template. Never commit backend/.env.
# Run Compose from backend/: docker compose --env-file .env up -d
# Initialization values apply only to an empty data directory.
# Changing this file does not rotate passwords in an existing database.
# Keep the persistent volume; do not use `down -v` to apply settings.
MARIADB_DATABASE=buteami
MARIADB_USER=buteami_app
MARIADB_PORT=3306

# Required: set different, locally generated passwords. No default secrets.
# Compose refuses to start while these values are empty.
# Quote values containing $ with single quotes in your local .env file.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
