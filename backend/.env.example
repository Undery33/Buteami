# Copy to .env locally. Never commit credentials or pass passwords in commands.
# Defaults describe the requested external DB; Compose OVERRIDES them to its
# disposable database and never connects to 192.168.20.10.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
DB_HOST=192.168.20.10
DB_PORT=3306
DB_NAME=buteami_db
DB_USER=buteami_app
DB_PASSWORD=
# Optional trusted CA bundle. If set, server certificate verification is required.
DB_TLS_CA_FILE=
# A random secret of at least 32 bytes; keep stable across pods and restarts.
APP_SECRET=
# Optional comma-separated trusted proxy CIDRs. Empty trusts no proxy headers.
TRUST_PROXY_CIDRS=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Buteami <no-reply@example.invalid>

# Required only for the disposable local Compose stack. Use separate random
# local passwords; these are not production DB credentials. Quote values with
# a literal $ in single quotes. Initialization affects only an empty volume.
LOCAL_DB_PASSWORD=
LOCAL_DB_ROOT_PASSWORD=
LOCAL_DB_PORT=13306
LOCAL_WEB_PORT=8080
LOCAL_MAIL_UI_PORT=8025
