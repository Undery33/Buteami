        <mxCell id="pU9jzDdXflwSQC5VRcOT-1" parent="uoETxpCozBrKZBP_7Y5_-58" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;" value="&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;③ 서비스·배포&lt;/strong&gt;&lt;/p&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;Kubernetes: Web/Application 컨테이너 배포 및 서비스 운영&lt;/li&gt;&lt;li&gt;Jenkins: GitHub → Jenkins → Kubernetes 자동 배포&lt;/li&gt;&lt;li&gt;Database Server: Web/Application 데이터를 별도 DB 서버에 저장&lt;/li&gt;&lt;li&gt;DHCP Server: VLAN별 IP Pool·Gateway·DNS 정보 자동 할당&lt;/li&gt;&lt;li&gt;DNS Server: 서버·네트워크 장비의 이름 기반 접근 제공&lt;/li&gt;&lt;li&gt;NTP 서버 구축&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="228.5" width="678" x="1.75" y="1285" as="geometry" />
        </mxCell>
        <mxCell id="pU9jzDdXflwSQC5VRcOT-5" parent="uoETxpCozBrKZBP_7Y5_-58" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;" value="&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;④ 서버 기반·관제&lt;/strong&gt;&lt;/p&gt;&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;NTP: Router / Switch / Linux 장비 시간 동기화&lt;/li&gt;&lt;li&gt;Syslog: 네트워크 장비·서버 로그 중앙 수집&lt;/li&gt;&lt;li&gt;SNMP / Zabbix: 장비 상태·트래픽 수집, 그래프 표시 및 장애·복구 감지&lt;/li&gt;&lt;li&gt;Prometheus / Grafana: 서버·Kubernetes 상세 지표 수집 및 시각화&amp;nbsp;&lt;/li&gt;&lt;li&gt;SSH Key 인증 계정 인증 접속&lt;/li&gt;&lt;li&gt;SFTP: 관리자–서버 및 서버 간 암호화 파일 전송&lt;/li&gt;&lt;li&gt;백업 관리: 각 파트의 백업 실행 주기와 결과 확인 방식 취합&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="231.5" width="685" x="679.75" y="1282" as="geometry" />
        </mxCell>
