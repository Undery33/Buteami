        <mxCell id="brDywWqUDDaWIIT5u9VX-112" parent="jkcWHd3Q-kjji-nyS68v-61" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=25;" value="VLAN 30 Office (Admin) Zone" vertex="1">
