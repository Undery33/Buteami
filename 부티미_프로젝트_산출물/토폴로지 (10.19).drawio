        <mxCell id="jkcWHd3Q-kjji-nyS68v-70" parent="jkcWHd3Q-kjji-nyS68v-61" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;fontStyle=1" value="ADMIN" vertex="1">
